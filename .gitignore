# Python byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# Python virtual environment
.venv/
venv/
ENV/
env/

# Testing and linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment files and secrets
.env
.env.*
!.env.example

# IDE and editor settings
.vscode/
.idea/
*.swp
*.swo

# Local SQLite databases
*.db
*.sqlite
*.sqlite3

# Uploaded documents / storage directory (keep folder tracked via .gitkeep)
storage/*
!storage/.gitkeep

# Local data directory (keep folder tracked via .gitkeep)
data/*
!data/.gitkeep

# Temporary files and logs
*.log
logs/
temp/
tmp/
